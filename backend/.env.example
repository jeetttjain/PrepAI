# ─────────────────────────────────────────────────────────────────────────────
# PREPAI BACKEND CONFIGURATION EXAMPLE
# Copy this file to '.env' and fill in your production credentials.
# Do NOT commit your real '.env' file to source control!
# ─────────────────────────────────────────────────────────────────────────────

# Host Port
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# MongoDB Connection String (Atlas or Local Instance)
# Replace with your secure production Mongo cluster URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/prepai?retryWrites=true&w=majority

# JSON Web Token Secret (Generate a strong 256-bit random string)
JWT_SECRET=your_super_secure_random_production_secret_key_here

# Groq Cloud API Credentials (For ultra-fast Llama-3 technical content synthesis)
GROQ_API_KEY=gsk_your_groq_production_key_here

# Frontend Application Origin (For CORS protection in production)
FRONTEND_URL=https://your-prepai-domain.com
